# Copy to terraform.tfvars and fill in.  (terraform.tfvars is gitignored.)

# Scope access to YOUR IP only — never 0.0.0.0/0.
#   echo "$(curl -s ifconfig.me)/32"
allowed_cidr = "203.0.113.4/32"

# An existing EC2 key pair name (see variables.tf for how to create one).
key_name = "argus"

# Optional overrides:
# region        = "us-east-1"
# instance_type = "t3.large"   # t3.medium (4 GB) is fine for a PREVENT-only box
# root_volume_gb = 40
