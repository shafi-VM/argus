# Copy to .env and fill in — `.env` is gitignored, never commit your key.
# Only needed for the SigNoz tier (`make demo-signoz`); the default `make demo` needs nothing.

# Your SigNoz service-account API key (SigNoz UI → Settings → API keys).
SIGNOZ_API_KEY=your-signoz-api-key

# Optional overrides. Defaults assume a standard Foundry SigNoz on `signoz-network`
# and talk to it by service DNS (no host round-trip). Override these if your SigNoz
# uses different service names/ports, e.g. host-published: http://host.docker.internal:8081
# SIGNOZ_URL=http://signoz-signoz-0:8080
# OTLP_ENDPOINT=signoz-ingester-1:4317
